<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

  <!-- ===== View: Claude Studio terminal ===== -->
  <extension point="org.eclipse.ui.views">
    <view
        id="org.claudecodestudio.views.ClaudeTerminalView"
        name="Claude Studio"
        class="org.claudecodestudio.views.ClaudeTerminalView"
        category="org.eclipse.ui"
        icon="icons/claude.png"
        allowMultiple="false"
        restorable="true"/>
  </extension>

  <!-- ===== Preference page ===== -->
  <extension point="org.eclipse.ui.preferencePages">
    <page
        id="org.claudecodestudio.preferences"
        name="Claude Studio"
        class="org.claudecodestudio.preferences.ClaudePreferencePage"/>
  </extension>

  <!-- ===== Command: open Claude Studio view ===== -->
  <extension point="org.eclipse.ui.commands">
    <command
        id="org.claudecodestudio.command.openView"
        name="Open Claude Studio"
        description="Opens the Claude Studio interactive terminal view"/>
  </extension>

  <!-- ===== Handler: wire command to action ===== -->
  <extension point="org.eclipse.ui.handlers">
    <handler
        commandId="org.claudecodestudio.command.openView"
        class="org.claudecodestudio.ui.OpenViewHandler"/>
  </extension>

  <!-- ===== Key binding: Ctrl+Shift+L to open view ===== -->
  <extension point="org.eclipse.ui.bindings">
    <key
        commandId="org.claudecodestudio.command.openView"
        schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
        sequence="M1+M2+L"/>
  </extension>

  <!-- ===== Perspective placement: stack with Console in the bottom panel ===== -->
  <!-- targetID="*" applies to all perspectives including Anypoint Studio's -->
  <extension point="org.eclipse.ui.perspectiveExtensions">
    <perspectiveExtension targetID="*">
      <view
          id="org.claudecodestudio.views.ClaudeTerminalView"
          relative="org.eclipse.ui.console.ConsoleView"
          relationship="stack"
          visible="false"/>
    </perspectiveExtension>
  </extension>

  <!-- ===== Menu contribution: Window > Show View > Claude Studio ===== -->
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=window">
    </menuContribution>
  </extension>

</plugin>
