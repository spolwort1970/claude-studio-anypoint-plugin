 org.eclipse.jface;bundle-version="3.0.0"
Bundle-ActivationPolicy: lazy
Export-Package: org.claudecodestudio,
 org.claudecodestudio.views,
 org.claudecodestudio.process,
 org.claudecodestudio.context,
 org.claudecodestudio.ui,
