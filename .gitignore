# Maven / Tycho build output
target/
bin/

# Eclipse project metadata (generated by IDE)
.project
.classpath
.settings/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files — exclude build artifacts everywhere EXCEPT dist/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!dist/*.jar

# Claude Code internal session data (not part of the project)
.claude/

# virtual machine crash logs
hs_err_pid*
replay_pid*
